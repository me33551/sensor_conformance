<?xml version="1.0"?>
<testset xmlns="http://cpee.org/ns/properties/2.0">
  <executionhandler>ruby</executionhandler>
  <dataelements>
    <seed/>
    <extra/>
    <phases/>
    <outcomes/>
    <at/>
    <decision/>
  </dataelements>
  <documents/>
  <endpoints>
    <timeout>https-post://cpee.org/services/timeout.php</timeout>
    <record>https-get://lehre.bpm.in.tum.de/ports/4570/record</record>
    <decide>https-get://lehre.bpm.in.tum.de/ports/4570/decide</decide>
  </endpoints>
  <attributes>
    <info>single_optionA</info>
    <creator>Christine Ashcreek</creator>
    <author>Christine Ashcreek</author>
    <executionhandler>ruby</executionhandler>
    <guarded>none</guarded>
    <modeltype>CPEE</modeltype>
    <theme>preset</theme>
    <guarded_id/>
    <model_uuid>0b6f2c1e-4f0a-4d2e-9a51-6f5c2d7e8a13</model_uuid>
    <model_version/>
    <design_stage>development</design_stage>
    <filter>me</filter>
    <design_dir>Staff.dir/Ehrendorfer.dir/conformance.dir/synthetic_adapted.dir/</design_dir>
  </attributes>
  <description>
    <description xmlns="http://cpee.org/ns/description/1.0">
      <manipulate id="a20" label="init simulation" color="#ffffcc">
        <code># all random numbers of the instance come from its seed, so that the instance can be regenerated
data.seed = Random.new_seed % 2147483647
r = Random.new(data.seed)
# repeated measurement at the beginning (extra iteration of "record") in 30% of the instances
data.extra = r.rand() &lt; 0.3
warmup = { 'name' =&gt; 'warmup', 'behavior' =&gt; 'steady', 'level' =&gt; 5, 'noise' =&gt; 0.3, 'points' =&gt; 10 }
ramp = { 'name' =&gt; 'ramp', 'behavior' =&gt; 'ramp', 'to' =&gt; 12, 'noise' =&gt; 0.3, 'points' =&gt; 10 }
outcome = { 'name' =&gt; 'outcome', 'behavior' =&gt; 'steady', 'noise' =&gt; 0.3, 'points' =&gt; 10 }
data.phases = ((data.extra ? [warmup, warmup] : [warmup]) + [ramp, outcome]).to_json
# the decision replaces the outcome phase: a stays at the level of the ramp, b (desired) decreases, c increases
data.outcomes = {
  'a' =&gt; [outcome],
  'b' =&gt; [outcome.merge('behavior' =&gt; 'ramp', 'to' =&gt; 3)],
  'c' =&gt; [outcome.merge('behavior' =&gt; 'ramp', 'to' =&gt; 18)]
}.to_json
data.at = data.extra ? 3 : 2</code>
      </manipulate>
      <parallel wait="-1" cancel="last">
        <parallel_branch>
          <call id="a1" endpoint="timeout">
            <parameters>
              <label>A</label>
              <color>#d4e1f1</color>
              <arguments>
                <timeout>4</timeout>
              </arguments>
            </parameters>
          </call>
          <call id="a13" endpoint="timeout">
            <parameters>
              <label>B</label>
              <color>#d4e1f1</color>
              <arguments>
                <timeout>6</timeout>
              </arguments>
            </parameters>
          </call>
          <call id="a8" endpoint="decide">
            <parameters>
              <label>random decision</label>
              <color>#f57aa9</color>
              <arguments>
                <options>{"a":2,"b":3,"c":1}</options>
                <outcomes>!data.outcomes</outcomes>
                <at>!data.at</at>
                <seed>!data.seed + 1</seed>
              </arguments>
            </parameters>
            <code>
              <finalize output="result">data.decision = result['decision']</finalize>
            </code>
          </call>
          <call id="a2" endpoint="timeout">
            <parameters>
              <label>C</label>
              <color>#d4e1f1</color>
              <arguments>
                <timeout>30</timeout>
              </arguments>
            </parameters>
          </call>
          <call id="a3" endpoint="timeout">
            <parameters>
              <label>D</label>
              <color>#d4e1f1</color>
              <arguments>
                <timeout>2</timeout>
              </arguments>
            </parameters>
          </call>
          <call id="a4" endpoint="timeout">
            <parameters>
              <label>E</label>
              <color>#d4e1f1</color>
              <arguments>
                <timeout>2</timeout>
              </arguments>
            </parameters>
          </call>
          <call id="a5" endpoint="timeout">
            <parameters>
              <label>F</label>
              <color>#d4e1f1</color>
              <arguments>
                <timeout>2</timeout>
              </arguments>
            </parameters>
          </call>
          <choose eid="e1" mode="exclusive">
            <alternative eid="e4" condition="data.decision == 'a'">
              <call id="a14" endpoint="timeout">
                <parameters>
                  <label>G</label>
                  <color>#d4e1f1</color>
                  <arguments>
                    <timeout>1</timeout>
                  </arguments>
                </parameters>
              </call>
            </alternative>
            <alternative eid="e2" condition="data.decision == 'b'">
              <call id="a7" endpoint="timeout">
                <parameters>
                  <label>H</label>
                  <color>#d4e1f1</color>
                  <arguments>
                    <timeout>1</timeout>
                  </arguments>
                </parameters>
              </call>
            </alternative>
            <otherwise eid="e3">
              <call id="a11" endpoint="timeout">
                <parameters>
                  <label>I</label>
                  <color>#d4e1f1</color>
                  <arguments>
                    <timeout>1</timeout>
                  </arguments>
                </parameters>
              </call>
            </otherwise>
          </choose>
        </parallel_branch>
        <parallel_branch>
          <call id="a6" endpoint="record">
            <parameters>
              <label>record</label>
              <color>#ffffcc</color>
              <arguments>
                <stream>sensor</stream>
                <interval>1</interval>
                <start>5</start>
                <seed>!data.seed</seed>
                <phases>!data.phases</phases>
              </arguments>
            </parameters>
            <annotations>
              <_context_data_analysis>
                <probes>
                  <probe>
                    <id>sensor</id>
                    <source>simulation</source>
                    <extractor_type>extrinsic</extractor_type>
                    <extractor_code>if(result.is_a?(Hash) &amp;&amp; result['points'].is_a?(Array)) then
  s = Stream.new('sensor')
  result['points'].each do |p|
    sp = StreamPoint.new('sensor')
    sp.value = p['value']
    sp.timestamp = p['timestamp']
    s &lt;&lt; sp
  end
  s
end</extractor_code>
                    <extractor_url/>
                    <extractor_params/>
                    <visualizer_url/>
                    <visualizer_params/>
                  </probe>
                </probes>
                <ips/>
              </_context_data_analysis>
            </annotations>
          </call>
        </parallel_branch>
      </parallel>
    </description>
  </description>
  <transformation>
    <description type="copy"/>
    <dataelements type="none"/>
    <endpoints type="none"/>
  </transformation>
</testset>
